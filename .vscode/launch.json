        {
            "name": "debug (gcc - gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "debug (msvc - cppvsdbg)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/elden-ring-damage-optimizer.exe",
            "cwd": "${workspaceFolder}",
