    "version": "0.2.0",
    "configurations": [
        {
            "name": "debug (clang - lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/elden-ring-damage-optimizer.exe",
            "args": [],
            "cwd": "${workspaceFolder}"
        },

        // {
